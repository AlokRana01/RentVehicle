# ==============================================================================
# E-RentVehicle - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows CMD)
#      Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in your own local development credentials.
# 3. NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Django Secret Key (generate a new one for production)
SECRET_KEY=replace-with-your-django-secret-key

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=127.0.0.1,localhost

# Razorpay API Credentials (from https://dashboard.razorpay.com/app/keys)
# Use test keys (rzp_test_...) for development
RAZORPAY_KEY_ID=replace-with-your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret
